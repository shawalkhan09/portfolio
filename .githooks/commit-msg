#!/bin/sh
# Backup for .claude/settings.json's includeCoAuthoredBy:false --
# strips any stray Claude/Anthropic attribution trailers so they
# never reach a commit even if that setting is bypassed.
sed -i.bak -E '/^(Co-Authored-By:.*Claude|Co-Authored-By:.*[Aa]nthropic|🤖 Generated with \[?Claude Code\]?.*)/Id' "$1"
rm -f "$1.bak"
